# nginx reverse proxy template for KKuTu (single domain)
# - Public: 80/443 (nginx)
# - Upstream: KKuTu Web HTTP port from Server/lib/sub/global.json (KKT_PORTAL_HTTP_PORT)
#
# NOTE:
# - Replace "kkutu.example.com" and certificate paths.
# - This proxies only the WEB portal. Game WebSockets still use MAIN_PORTS/ROOM_PORTS directly.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream kkutu_web {
    # KKT_PORTAL_HTTP_PORT (current: 4444)
    server 127.0.0.1:4444;
}

server {
    listen 80;
    listen [::]:80;

    server_name kkutu.example.com;

    # If you use Certbot HTTP-01, keep this location.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name kkutu.example.com;

    # Example (Certbot). Replace with your real paths.
    ssl_certificate     /etc/letsencrypt/live/kkutu.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kkutu.example.com/privkey.pem;

    location / {
        proxy_pass http://kkutu_web;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # If you are behind Cloudflare and use GLOBAL.WAF, keep passing this header.
        proxy_set_header CF-Connecting-IP  $http_cf_connecting_ip;

        # WebSocket (safe to include even if not used by the portal)
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
